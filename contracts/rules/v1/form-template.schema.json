{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/contracts/rules/v1/form-template.schema.json",
  "title": "form_template (v1)",
  "description": "확인서 서식 템플릿. 항목명·필수 여부·배치는 데이터다(CLAUDE.md 절대 규칙 4). 협회 표준서식이 정본이며(설계서 §14 #2), 확인되지 않은 항목명은 넣지 않고 pendingConfirmation에 자리만 둔다.",
  "type": "object",
  "required": ["templateId", "templateType", "version", "applyFrom", "fields", "layout"],
  "properties": {
    "templateId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$" },
    "templateType": { "enum": ["STANDARD", "AUTO"], "description": "AUTO(자동차보험)는 예약" },
    "version": { "type": "integer", "minimum": 1 },
    "applyFrom": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "applyTo": { "type": ["string", "null"], "format": "date" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "layout": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "fields"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "orientation": { "enum": ["COLUMN_PER_ITEM", "DOCUMENT"] },
              "fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "pendingConfirmation": {
      "type": "array",
      "description": "정본 확인 전이라 항목명을 넣지 않은 자리(예: TODO(confirm#2)). 렌더러는 이 목록을 인쇄하지 않는다.",
      "items": {
        "type": "object",
        "required": ["ref", "note"],
        "properties": {
          "ref": { "type": "string", "pattern": "^TODO\\(confirm#\\d+\\)$" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["code", "label", "required", "source", "order", "render"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "source": { "enum": ["CATALOG", "ENGINE", "AGENT", "SYSTEM"] },
        "order": { "type": "integer", "minimum": 1 },
        "render": {
          "type": "object",
          "properties": {
            "scope": { "enum": ["PER_ITEM", "PER_DOCUMENT"] },
            "readOnly": { "type": "boolean" },
            "unavailableText": { "type": "string" }
          }
        }
      }
    }
  }
}
