{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/contracts/rules/v1/rule-version.schema.json",
  "title": "rule_version.body (v1)",
  "description": "룰 버전 본문(설계서 부록 D). 룰은 코드가 아니라 데이터다 — 값은 전부 예시이며 실값은 설계서 §14 확인 후 데이터로 설정한다. GLOBAL(규제) 본문은 이 스키마를 그대로 통과해야 하고, TENANT(사규) 본문은 tenantOverridable 키만 가진 부분 문서로서 GLOBAL 위에 병합한 결과가 이 스키마를 통과해야 한다(설계서 §6.2). 필드 추가는 호환(additionalProperties 허용), 삭제·의미 변경은 v2.",
  "type": "object",
  "required": [
    "minCompare",
    "distinctInsurer",
    "gradeRequired",
    "allowedGradingPolicies",
    "allowedRankingPolicies",
    "snapshotMaxAgeDays",
    "reasonCodes",
    "signerSet",
    "signOrder",
    "managerConfirmMode",
    "signDeadlineDays",
    "gateRequiresManager",
    "remoteLinkTtlHours",
    "channels",
    "identityCheck",
    "proxySignatureDetection",
    "subjectRule",
    "retentionYears",
    "retainUnlinked",
    "validations",
    "allowedTieBreaks",
    "reasonTextMaxLength",
    "tenantOverridable",
    "exceptionApproval",
    "masking",
    "voidReasons",
    "supersedeReasons",
    "lifecycleReasonTextMaxLength",
    "retentionAnchors",
    "sessionTtlMinutes",
    "agentSignMethod",
    "anchoring",
    "retentionDays",
    "retention",
    "legalHoldReasons",
    "legalHoldReasonTextMaxLength",
    "customerRef",
    "verify",
    "legalHoldReleaseReasons",
    "api",
    "publicSign",
    "notify",
    "complianceQueue",
    "collectionRate",
    "draft",
    "contractLink",
    "gate",
    "customers"
  ],
  "properties": {
    "minCompare": {
      "type": "integer",
      "minimum": 1,
      "description": "최소 비교(추천) 상품 수"
    },
    "distinctInsurer": {
      "type": "boolean"
    },
    "gradeRequired": {
      "type": "object",
      "required": [
        "whenLargeGa"
      ],
      "properties": {
        "whenLargeGa": {
          "type": "boolean"
        }
      }
    },
    "allowedGradingPolicies": {
      "$ref": "#/$defs/policyIds"
    },
    "allowedRankingPolicies": {
      "$ref": "#/$defs/policyIds"
    },
    "allowedTieBreaks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SHARED_RANK",
          "STRICT"
        ]
      },
      "description": "엔진 응답 tieBreak의 허용값(설계서 §4.1·§6.3 (iv))"
    },
    "snapshotMaxAgeDays": {
      "type": "integer",
      "minimum": 0
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          },
          "auto": {
            "type": "boolean",
            "description": "시스템이 조건에 따라 부가하는 코드(예: 고객 요청 보험사). 설계사 선택지가 아니다."
          }
        }
      }
    },
    "reasonTextMaxLength": {
      "type": "integer",
      "minimum": 1,
      "description": "R-REASON 추천사유 텍스트 길이 상한(문자 수)"
    },
    "voidReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          }
        }
      },
      "description": "무효 사유 코드(3B 수용심사 §2-2). 닫힌 목록 — requiresText면 텍스트 필수. GLOBAL 전용."
    },
    "supersedeReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          }
        }
      },
      "description": "정정 사유 코드(3B 수용심사 §2-2). 닫힌 목록 — requiresText면 텍스트 필수. GLOBAL 전용."
    },
    "lifecycleReasonTextMaxLength": {
      "type": "integer",
      "minimum": 1,
      "description": "무효·정정 사유 텍스트 상한(추천사유 reasonTextMaxLength와 별개). GLOBAL 전용."
    },
    "signerSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CUSTOMER",
          "AGENT",
          "MANAGER"
        ]
      }
    },
    "signOrder": {
      "enum": [
        "SEQUENTIAL",
        "PARALLEL"
      ],
      "description": "SEQUENTIAL(signerSet 순서대로) | PARALLEL(순서 무관, 전원 필요)"
    },
    "managerConfirmMode": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "OFF"
      ],
      "description": "REQUIRED면 signerSet에 MANAGER가 있어야 하고, OPTIONAL·OFF면 없어야 한다(아래 allOf)"
    },
    "signDeadlineDays": {
      "type": "integer",
      "minimum": 0
    },
    "gateRequiresManager": {
      "type": "boolean"
    },
    "remoteLinkTtlHours": {
      "type": "integer",
      "minimum": 1
    },
    "sessionTtlMinutes": {
      "type": "object",
      "required": [
        "TOUCH_PAD",
        "PAPER_SCAN"
      ],
      "additionalProperties": false,
      "description": "고객 서명 세션의 유효 시간(분). REMOTE_LINK는 remoteLinkTtlHours. 세션 만료 = min(발급 + TTL, 서명 기한 끝)(4 계획 §2.2).",
      "properties": {
        "TOUCH_PAD": {
          "type": "integer",
          "minimum": 1
        },
        "PAPER_SCAN": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "agentSignMethod": {
      "enum": [
        "DRAWN",
        "SSO_APPROVAL"
      ],
      "description": "설계사 서명 방식 — 터치 서명(DRAWN) 또는 승인 클릭(SSO_APPROVAL). 채널은 언제나 SSO(4 계획 승인 Q3)."
    },
    "channels": {
      "type": "object",
      "required": [
        "TOUCH_PAD",
        "REMOTE_LINK",
        "PAPER_SCAN",
        "CERTIFIED_ESIGN"
      ],
      "description": "채널별 허용과 정책(v1.9, 4 계획 승인 Q5). 값은 객체 — PAPER_SCAN만 requiresManagerReview(봉인 후 종이 스캔 서명의 관리자 검토 강제, 기본 true)를 가진다.",
      "properties": {
        "TOUCH_PAD": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "REMOTE_LINK": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "CERTIFIED_ESIGN": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "PAPER_SCAN": {
          "type": "object",
          "required": [
            "enabled",
            "requiresManagerReview"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "requiresManagerReview": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "identityCheck": {
      "type": "object",
      "required": [
        "maxFailures"
      ],
      "properties": {
        "maxFailures": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^(TOUCH_PAD|REMOTE_LINK|PAPER_SCAN|CERTIFIED_ESIGN)$": {
          "type": "array",
          "items": {
            "enum": [
              "LINK_POSSESSION",
              "BIRTH_DATE",
              "AGENT_FACE_TO_FACE",
              "SCROLL_COMPLETE",
              "PROVIDER"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "proxySignatureDetection": {
      "type": "object",
      "required": [
        "sameDeviceDistinctCustomersPerDay",
        "minSecondsFromSendToSign"
      ],
      "properties": {
        "sameDeviceDistinctCustomersPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "minSecondsFromSendToSign": {
          "type": "integer",
          "minimum": 0
        },
        "sameIpDistinctCustomersPerDay": {
          "type": "integer",
          "minimum": 1,
          "description": "선택 — 없으면 IP 지표를 쓰지 않는다(이동통신 NAT 오탐, 4 계획 승인 Q8)."
        }
      }
    },
    "anchoring": {
      "type": "object",
      "required": [
        "treeDepth"
      ],
      "additionalProperties": false,
      "description": "일일 앵커의 머클 트리(5 계획 §2, 승인 Q7). 깊이는 고정이고 빈 자리는 상수 패딩 잎 — 경로 길이가 테넌트 수와 무관하다. 루트는 전 테넌트 하나이므로 GLOBAL 전용(테넌트별 TSA 선택·해제는 없다 — TSA 엔드포인트·신뢰 앵커는 배포 설정).",
      "properties": {
        "treeDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    "subjectRule": {
      "type": "object",
      "required": [
        "largeGaOnly",
        "excludedGroups",
        "contractDateFrom"
      ],
      "properties": {
        "largeGaOnly": {
          "type": "boolean"
        },
        "excludedGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractDateFrom": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "retentionYears": {
      "type": "integer",
      "minimum": 0,
      "description": "보존기간(년). 기간 = retentionYears년 + retentionDays일(산식 하나, 5 계획 승인 Q5) — 합계는 1일 이상(allOf). GLOBAL 전용."
    },
    "retentionDays": {
      "type": "integer",
      "minimum": 0,
      "description": "보존기간에 더하는 일수(테스트·데모의 짧은 보존을 같은 산식으로, 승인 Q5). GLOBAL 전용."
    },
    "retentionAnchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SEAL",
          "COMPLETION",
          "CONTRACT_DATE"
        ]
      },
      "description": "보존기한 앵커(3B 수용심사 §3-3). retention_until = max(각 앵커 날짜 + retentionYears), 앵커가 생길 때마다 다시 계산해 연장만 한다. GLOBAL 전용."
    },
    "retention": {
      "type": "object",
      "required": [
        "contractLinkWaitDays"
      ],
      "additionalProperties": false,
      "description": "파기 절차 파라미터(판정 시점의 ACTIVE 룰로 읽는다 — 승인 Q10). 사규로 덮어쓸 수 있다.",
      "properties": {
        "contractLinkWaitDays": {
          "type": "integer",
          "minimum": 0,
          "description": "COMPLETED 확인서의 CONTRACT_DATE 앵커를 기다리는 일수. 완료일(KST) + 이 값이 지나면 '계약 없음'으로 확정하고 파기 감사에 anchorsWaived를 남긴다."
        }
      }
    },
    "legalHoldReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          }
        }
      },
      "description": "법적 보류 사유 코드. 닫힌 목록 — requiresText면 텍스트 필수. GLOBAL 전용."
    },
    "legalHoldReasonTextMaxLength": {
      "type": "integer",
      "minimum": 1,
      "description": "법적 보류 사유 텍스트 상한. GLOBAL 전용."
    },
    "legalHoldReleaseReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "법적 보류 해제 사유 코드(5 수용심사 D12 — §14 #15를 6A에서 닫는다). 닫힌 목록, 해제에는 텍스트가 없다. 해제자 ≠ 설정자(4-eyes)는 유스케이스와 DB CHECK. GLOBAL 전용."
    },
    "customerRef": {
      "type": "object",
      "required": [
        "graceDaysAfterLastDestruction",
        "abandonedDays"
      ],
      "additionalProperties": false,
      "description": "고객 파기 절차 파라미터(판정 시점 룰). 사규로 덮어쓸 수 있다.",
      "properties": {
        "graceDaysAfterLastDestruction": {
          "type": "integer",
          "minimum": 0
        },
        "abandonedDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "verify": {
      "type": "object",
      "required": [
        "unstampedAnchorAlertDays"
      ],
      "additionalProperties": false,
      "description": "검증 파라미터. GLOBAL 전용.",
      "properties": {
        "unstampedAnchorAlertDays": {
          "type": "integer",
          "minimum": 0,
          "description": "영수증 없는 앵커가 이 일수를 넘기면 verify tenant 발견 ANCHOR_UNSTAMPED."
        }
      }
    },
    "api": {
      "type": "object",
      "required": [
        "idempotencyTtlHours",
        "idempotencyLeaseSeconds"
      ],
      "additionalProperties": false,
      "description": "내부 REST 파라미터(6A). GLOBAL 전용.",
      "properties": {
        "idempotencyTtlHours": {
          "type": "integer",
          "minimum": 1,
          "description": "Idempotency-Key 보관 시간. 지나면 IDEMPOTENCY_PURGE 작업이 지운다."
        },
        "idempotencyLeaseSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "진행 중 키의 임차 — 이 시간이 지나도록 완료되지 않은 키는 같은 요청이 인수한다(claim_seq + 1)."
        }
      }
    },
    "publicSign": {
      "type": "object",
      "required": [
        "tenantRatePerMinute"
      ],
      "additionalProperties": false,
      "description": "고객 공개 서명 경로 파라미터(6A). 응답 패딩 하한은 룰이 아니라 배포 설정 ga.public-sign.min-response-millis다(6A 승인 Q6 — 없는 테넌트에도 같아야 하는 값). GLOBAL 전용.",
      "properties": {
        "tenantRatePerMinute": {
          "type": "integer",
          "minimum": 1,
          "description": "테넌트별 공개 경로 분당 요청 한도(고정 1분 창, 인스턴스별). 초과는 거부 응답과 같은 바이트."
        }
      }
    },
    "notify": {
      "type": "object",
      "required": [
        "retry"
      ],
      "additionalProperties": false,
      "description": "통지 아웃박스 파라미터(6A). 실행 시점(오늘 KST)의 ACTIVE 룰로 읽는다. GLOBAL 전용.",
      "properties": {
        "retry": {
          "type": "object",
          "required": [
            "maxAttempts",
            "initialDelaySeconds",
            "multiplier",
            "maxDelaySeconds"
          ],
          "additionalProperties": false,
          "description": "재시도 백오프: delay(n) = min(maxDelaySeconds, initialDelaySeconds × multiplier^(n−1)), n = 실패 후 시도 수. maxAttempts번째 실패에서 DEAD + NOTIFY_FAILED 플래그. 정수 산술, 지터 없음.",
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 1
            },
            "multiplier": {
              "type": "integer",
              "minimum": 1
            },
            "maxDelaySeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "retainUnlinked": {
      "type": "boolean"
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "description": "검증 규칙과 실행 단계(설계서 §6.2, Phase 1 수용 심사 §3-1). 실행기는 run(stage)로 그 단계에 나열된 규칙만 이 순서대로 실행한다. 기본값 없음 — stages가 빈 규칙은 스키마 위반. id 중복은 번들 로더·해석기가 거부한다(JSON Schema로는 객체 배열의 키 유일성을 표현할 수 없다). SEAL은 이전 단계 규칙의 방어적 재검증.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stages"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[A-Z0-9-]+$"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "COMPARE",
                "GRADE",
                "REASON",
                "SEAL",
                "COMPLETE"
              ]
            }
          }
        }
      }
    },
    "exceptionApproval": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "description": "산출불가·임시등록·검증 오버라이드의 예외 승인 주체(설계서 §6.5). managerConfirmMode(문서마다의 관리자 서명)와 무관하게 항상 필요하고, 서명이 아니라 review 기록(compliance_flag.resolution + audit_log)이다. GLOBAL 전용 — tenantOverridable에 넣을 수 없다.",
      "properties": {
        "role": {
          "enum": [
            "MANAGER"
          ]
        }
      }
    },
    "masking": {
      "type": "object",
      "required": [
        "name",
        "phone",
        "birthDate"
      ],
      "additionalProperties": false,
      "description": "화면·문서 표시용 부분 마스킹(설계서 §9, 미결정 §14 #12 — 예시값). 앞 keepFirst자·뒤 keepLast자만 남긴다. 로그·예외·toString은 이것과 무관하게 전부 가린다(Sensitive). 테넌트가 사규로 덮어쓸 수 있다.",
      "properties": {
        "name": {
          "type": "object",
          "required": [
            "keepFirst",
            "keepLast",
            "maskChar"
          ],
          "additionalProperties": false,
          "properties": {
            "keepFirst": {
              "type": "integer",
              "minimum": 0
            },
            "keepLast": {
              "type": "integer",
              "minimum": 0
            },
            "maskChar": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          }
        },
        "phone": {
          "type": "object",
          "required": [
            "keepFirst",
            "keepLast",
            "maskChar"
          ],
          "additionalProperties": false,
          "properties": {
            "keepFirst": {
              "type": "integer",
              "minimum": 0
            },
            "keepLast": {
              "type": "integer",
              "minimum": 0
            },
            "maskChar": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          }
        },
        "birthDate": {
          "type": "object",
          "required": [
            "keepFirst",
            "keepLast",
            "maskChar"
          ],
          "additionalProperties": false,
          "properties": {
            "keepFirst": {
              "type": "integer",
              "minimum": 0
            },
            "keepLast": {
              "type": "integer",
              "minimum": 0
            },
            "maskChar": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          }
        }
      }
    },
    "tenantOverridable": {
      "type": "array",
      "uniqueItems": true,
      "description": "TENANT(사규) 룰이 덮어쓸 수 있는 최상위 키 목록. 규제 핵심 키는 넣을 수 없다(not/enum) — \"사규는 규제를 완화할 수 없다\"의 데이터 표현(Phase 1 지시문 §3).",
      "items": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$",
        "not": {
          "enum": [
            "tenantOverridable",
            "validations",
            "minCompare",
            "signerSet",
            "managerConfirmMode",
            "subjectRule",
            "gradeRequired",
            "allowedGradingPolicies",
            "allowedRankingPolicies",
            "allowedTieBreaks",
            "exceptionApproval",
            "voidReasons",
            "supersedeReasons",
            "lifecycleReasonTextMaxLength",
            "retentionAnchors",
            "anchoring",
            "retentionYears",
            "retentionDays",
            "legalHoldReasons",
            "legalHoldReasonTextMaxLength",
            "verify",
            "legalHoldReleaseReasons",
            "api",
            "publicSign",
            "notify",
            "collectionRate",
            "gate"
          ]
        }
      }
    },
    "complianceQueue": {
      "type": "object",
      "required": [
        "types"
      ],
      "additionalProperties": false,
      "description": "준법 큐(6B). 플래그 유형 전부의 정책 — 유형 목록은 닫혀 있고 DB CHECK·코드 상수와 FlagTypeTableTest가 양방향으로 대조한다. 사규로 덮어쓸 수 있다(최상위 키 단위).",
      "properties": {
        "types": {
          "type": "object",
          "required": [
            "GRADE_INCONSISTENT",
            "VALIDATION_OVERRIDE",
            "RULE_SUPERSEDED_DRAFT",
            "IDENTITY_FAILED",
            "SIGNATURE_DEVICE_REUSE",
            "PAPER_SCAN_REVIEW",
            "SIGN_EXPIRED",
            "CHAIN_BROKEN",
            "NOTIFY_FAILED",
            "RULE_DRIFT",
            "RULE_ACTIVATION_MISSED"
          ],
          "additionalProperties": false,
          "properties": {
            "GRADE_INCONSISTENT": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "VALIDATION_OVERRIDE": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "RULE_SUPERSEDED_DRAFT": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "IDENTITY_FAILED": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "SIGNATURE_DEVICE_REUSE": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "PAPER_SCAN_REVIEW": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "SIGN_EXPIRED": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "CHAIN_BROKEN": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "NOTIFY_FAILED": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "RULE_DRIFT": {
              "$ref": "#/$defs/flagTypePolicy"
            },
            "RULE_ACTIVATION_MISSED": {
              "$ref": "#/$defs/flagTypePolicy"
            }
          }
        }
      }
    },
    "collectionRate": {
      "type": "object",
      "required": [
        "formula"
      ],
      "additionalProperties": false,
      "description": "징구율 — 내부 지표(규제 정의 없음, §14 #17). 산식은 닫힌 enum이고 스냅샷은 산식 ID와 룰 버전으로 구분한다. GLOBAL 전용.",
      "properties": {
        "formula": {
          "enum": [
            "LINKED_COMPLETED_BY_CONTRACT_DATE",
            "TARGET_INCLUDING_UNMATCHED"
          ]
        }
      }
    },
    "draft": {
      "type": "object",
      "required": [
        "abandonAfterDays",
        "abandonReasons"
      ],
      "additionalProperties": false,
      "description": "봉인 전 초안의 폐기(6B, §14 #13). 사규로 덮어쓸 수 있다.",
      "properties": {
        "abandonAfterDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "마지막 변경 뒤 이 일수가 지난 초안을 배치 ABANDON_DRAFTS가 폐기한다. null이면 배치는 아무것도 하지 않는다(실값 미정 — 지어내지 않는다)."
        },
        "abandonReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "설계사 명시 폐기 사유 코드(닫힌 목록, 텍스트 없음 — 예시값)."
        }
      }
    },
    "contractLink": {
      "type": "object",
      "required": [
        "unmatchedRetentionDays"
      ],
      "additionalProperties": false,
      "description": "계약 연결(6B). 사규로 덮어쓸 수 있다.",
      "properties": {
        "unmatchedRetentionDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "미매칭 보고 행(증권번호)을 받은 뒤 이 일수가 지나면 CONTRACT_LINK_UNMATCHED_PURGE가 지운다. null이면 지우지 않는다(실값 미정 — §14 #16)."
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "perMinutePerPrincipal"
      ],
      "additionalProperties": false,
      "description": "청약 게이트(6B, POST /internal/v1/gate). GLOBAL 전용.",
      "properties": {
        "perMinutePerPrincipal": {
          "type": "integer",
          "minimum": 1,
          "description": "서비스 주체(GATE_CLIENT)별 분당 요청 한도. 실값은 §14 #10."
        }
      }
    },
    "customers": {
      "type": "object",
      "required": [
        "registerPerMinute"
      ],
      "additionalProperties": false,
      "description": "고객 등록 API(6B §9, POST /api/v1/customers). 사규로 덮어쓸 수 있다(최상위 키 단위).",
      "properties": {
        "registerPerMinute": {
          "type": "integer",
          "minimum": 1,
          "description": "등록 주체(설계사)별 지난 60초 등록 시도(감사 CUSTOMER_REGISTER 행) 한도 — 넘으면 429. 예시값, 실값은 §14 #10."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "managerConfirmMode": {
            "const": "REQUIRED"
          }
        },
        "required": [
          "managerConfirmMode"
        ]
      },
      "then": {
        "properties": {
          "signerSet": {
            "contains": {
              "const": "MANAGER"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "managerConfirmMode": {
            "enum": [
              "OPTIONAL",
              "OFF"
            ]
          }
        },
        "required": [
          "managerConfirmMode"
        ]
      },
      "then": {
        "properties": {
          "signerSet": {
            "not": {
              "contains": {
                "const": "MANAGER"
              }
            }
          }
        }
      }
    },
    {
      "description": "보존기간 합계 ≥ 1일(5 계획 승인 Q5) — 봉인 직후 '이미 끝난 보존'은 생길 수 없다.",
      "anyOf": [
        {
          "properties": {
            "retentionYears": {
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "retentionDays": {
              "minimum": 1
            }
          }
        }
      ]
    },
    {
      "description": "옛 테넌트 키 anchor(externalTimestamp·tsaProfile)는 v1.11에서 GLOBAL anchoring으로 대체됐다 — 다시 쓸 수 없다(5 계획 승인 Q7).",
      "not": {
        "required": [
          "anchor"
        ]
      }
    },
    {
      "description": "옛 자유 문자열 kpi.collectionRate는 v1.14(6B)에서 닫힌 산식 ID collectionRate.formula로 대체됐다 — 다시 쓸 수 없다(6B 계획 §5).",
      "not": {
        "required": [
          "kpi"
        ]
      }
    }
  ],
  "$defs": {
    "policyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
      }
    },
    "flagTypePolicy": {
      "type": "object",
      "required": [
        "assignedRole",
        "slaHours",
        "visibleToAgent",
        "resolutionCodes",
        "requiresEvidence"
      ],
      "additionalProperties": false,
      "description": "플래그 유형 하나의 준법 큐 정책. 담당·가시성·기한은 플래그가 생길 때 복사해 고정한다(V14). resolutionCodes가 비면 수동 해소가 없다(문서 상태·전용 유스케이스로만 닫힌다).",
      "properties": {
        "assignedRole": {
          "enum": [
            "COMPLIANCE",
            "MANAGER"
          ]
        },
        "slaHours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "열린 시각 + 이 시간이 기한(due_at). null이면 기한 없음 — 실값은 지어내지 않는다(§14 #18)."
        },
        "visibleToAgent": {
          "type": "boolean",
          "description": "설계사가 자기 확인서의 이 유형 플래그를 보는가(6A 수용심사 §2 ① — 지금은 전부 false)."
        },
        "resolutionCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "수동 해소 사유 코드(닫힌 목록, 예시값 — §14 #18)."
        },
        "requiresEvidence": {
          "type": "boolean",
          "description": "해소에 근거(유형별 닫힌 모양)가 필요한가. CHAIN_BROKEN은 verifyRunJobId."
        }
      }
    }
  }
}
