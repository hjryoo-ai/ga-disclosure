{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/contracts/rules/v1/rule-version.schema.json",
  "title": "rule_version.body (v1)",
  "description": "룰 버전 본문(설계서 부록 D). 룰은 코드가 아니라 데이터다 — 값은 전부 예시이며 실값은 설계서 §14 확인 후 데이터로 설정한다. GLOBAL(규제) 본문은 이 스키마를 그대로 통과해야 하고, TENANT(사규) 본문은 tenantOverridable 키만 가진 부분 문서로서 GLOBAL 위에 병합한 결과가 이 스키마를 통과해야 한다(설계서 §6.2). 필드 추가는 호환(additionalProperties 허용), 삭제·의미 변경은 v2.",
  "type": "object",
  "required": [
    "minCompare",
    "distinctInsurer",
    "gradeRequired",
    "allowedGradingPolicies",
    "allowedRankingPolicies",
    "snapshotMaxAgeDays",
    "reasonCodes",
    "signerSet",
    "signOrder",
    "managerConfirmMode",
    "signDeadlineDays",
    "gateRequiresManager",
    "remoteLinkTtlHours",
    "channels",
    "identityCheck",
    "proxySignatureDetection",
    "anchor",
    "subjectRule",
    "kpi",
    "retentionYears",
    "retainUnlinked",
    "validations",
    "allowedTieBreaks",
    "reasonTextMaxLength",
    "tenantOverridable",
    "exceptionApproval",
    "masking",
    "voidReasons",
    "supersedeReasons",
    "lifecycleReasonTextMaxLength",
    "retentionAnchors",
    "sessionTtlMinutes",
    "agentSignMethod"
  ],
  "properties": {
    "minCompare": {
      "type": "integer",
      "minimum": 1,
      "description": "최소 비교(추천) 상품 수"
    },
    "distinctInsurer": {
      "type": "boolean"
    },
    "gradeRequired": {
      "type": "object",
      "required": [
        "whenLargeGa"
      ],
      "properties": {
        "whenLargeGa": {
          "type": "boolean"
        }
      }
    },
    "allowedGradingPolicies": {
      "$ref": "#/$defs/policyIds"
    },
    "allowedRankingPolicies": {
      "$ref": "#/$defs/policyIds"
    },
    "allowedTieBreaks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SHARED_RANK",
          "STRICT"
        ]
      },
      "description": "엔진 응답 tieBreak의 허용값(설계서 §4.1·§6.3 (iv))"
    },
    "snapshotMaxAgeDays": {
      "type": "integer",
      "minimum": 0
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          },
          "auto": {
            "type": "boolean",
            "description": "시스템이 조건에 따라 부가하는 코드(예: 고객 요청 보험사). 설계사 선택지가 아니다."
          }
        }
      }
    },
    "reasonTextMaxLength": {
      "type": "integer",
      "minimum": 1,
      "description": "R-REASON 추천사유 텍스트 길이 상한(문자 수)"
    },
    "voidReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          }
        }
      },
      "description": "무효 사유 코드(3B 수용심사 §2-2). 닫힌 목록 — requiresText면 텍스트 필수. GLOBAL 전용."
    },
    "supersedeReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          }
        }
      },
      "description": "정정 사유 코드(3B 수용심사 §2-2). 닫힌 목록 — requiresText면 텍스트 필수. GLOBAL 전용."
    },
    "lifecycleReasonTextMaxLength": {
      "type": "integer",
      "minimum": 1,
      "description": "무효·정정 사유 텍스트 상한(추천사유 reasonTextMaxLength와 별개). GLOBAL 전용."
    },
    "signerSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CUSTOMER",
          "AGENT",
          "MANAGER"
        ]
      }
    },
    "signOrder": {
      "enum": [
        "SEQUENTIAL",
        "PARALLEL"
      ],
      "description": "SEQUENTIAL(signerSet 순서대로) | PARALLEL(순서 무관, 전원 필요)"
    },
    "managerConfirmMode": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "OFF"
      ],
      "description": "REQUIRED면 signerSet에 MANAGER가 있어야 하고, OPTIONAL·OFF면 없어야 한다(아래 allOf)"
    },
    "signDeadlineDays": {
      "type": "integer",
      "minimum": 0
    },
    "gateRequiresManager": {
      "type": "boolean"
    },
    "remoteLinkTtlHours": {
      "type": "integer",
      "minimum": 1
    },
    "sessionTtlMinutes": {
      "type": "object",
      "required": [
        "TOUCH_PAD",
        "PAPER_SCAN"
      ],
      "additionalProperties": false,
      "description": "고객 서명 세션의 유효 시간(분). REMOTE_LINK는 remoteLinkTtlHours. 세션 만료 = min(발급 + TTL, 서명 기한 끝)(4 계획 §2.2).",
      "properties": {
        "TOUCH_PAD": {
          "type": "integer",
          "minimum": 1
        },
        "PAPER_SCAN": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "agentSignMethod": {
      "enum": [
        "DRAWN",
        "SSO_APPROVAL"
      ],
      "description": "설계사 서명 방식 — 터치 서명(DRAWN) 또는 승인 클릭(SSO_APPROVAL). 채널은 언제나 SSO(4 계획 승인 Q3)."
    },
    "channels": {
      "type": "object",
      "required": [
        "TOUCH_PAD",
        "REMOTE_LINK",
        "PAPER_SCAN",
        "CERTIFIED_ESIGN"
      ],
      "description": "채널별 허용과 정책(v1.9, 4 계획 승인 Q5). 값은 객체 — PAPER_SCAN만 requiresManagerReview(봉인 후 종이 스캔 서명의 관리자 검토 강제, 기본 true)를 가진다.",
      "properties": {
        "TOUCH_PAD": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "REMOTE_LINK": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "CERTIFIED_ESIGN": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "PAPER_SCAN": {
          "type": "object",
          "required": [
            "enabled",
            "requiresManagerReview"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "requiresManagerReview": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "identityCheck": {
      "type": "object",
      "required": [
        "maxFailures"
      ],
      "properties": {
        "maxFailures": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^(TOUCH_PAD|REMOTE_LINK|PAPER_SCAN|CERTIFIED_ESIGN)$": {
          "type": "array",
          "items": {
            "enum": [
              "LINK_POSSESSION",
              "BIRTH_DATE",
              "AGENT_FACE_TO_FACE",
              "SCROLL_COMPLETE",
              "PROVIDER"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "proxySignatureDetection": {
      "type": "object",
      "required": [
        "sameDeviceDistinctCustomersPerDay",
        "minSecondsFromSendToSign"
      ],
      "properties": {
        "sameDeviceDistinctCustomersPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "minSecondsFromSendToSign": {
          "type": "integer",
          "minimum": 0
        },
        "sameIpDistinctCustomersPerDay": {
          "type": "integer",
          "minimum": 1,
          "description": "선택 — 없으면 IP 지표를 쓰지 않는다(이동통신 NAT 오탐, 4 계획 승인 Q8)."
        }
      }
    },
    "anchor": {
      "type": "object",
      "required": [
        "externalTimestamp"
      ],
      "properties": {
        "externalTimestamp": {
          "type": "boolean"
        },
        "tsaProfile": {
          "type": "string"
        }
      }
    },
    "subjectRule": {
      "type": "object",
      "required": [
        "largeGaOnly",
        "excludedGroups",
        "contractDateFrom"
      ],
      "properties": {
        "largeGaOnly": {
          "type": "boolean"
        },
        "excludedGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractDateFrom": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "kpi": {
      "type": "object",
      "required": [
        "collectionRate"
      ],
      "properties": {
        "collectionRate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retentionYears": {
      "type": "integer",
      "minimum": 1
    },
    "retentionAnchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SEAL",
          "COMPLETION",
          "CONTRACT_DATE"
        ]
      },
      "description": "보존기한 앵커(3B 수용심사 §3-3). retention_until = max(각 앵커 날짜 + retentionYears), 앵커가 생길 때마다 다시 계산해 연장만 한다. GLOBAL 전용."
    },
    "retainUnlinked": {
      "type": "boolean"
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "description": "검증 규칙과 실행 단계(설계서 §6.2, Phase 1 수용 심사 §3-1). 실행기는 run(stage)로 그 단계에 나열된 규칙만 이 순서대로 실행한다. 기본값 없음 — stages가 빈 규칙은 스키마 위반. id 중복은 번들 로더·해석기가 거부한다(JSON Schema로는 객체 배열의 키 유일성을 표현할 수 없다). SEAL은 이전 단계 규칙의 방어적 재검증.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stages"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[A-Z0-9-]+$"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "COMPARE",
                "GRADE",
                "REASON",
                "SEAL",
                "COMPLETE"
              ]
            }
          }
        }
      }
    },
    "exceptionApproval": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "description": "산출불가·임시등록·검증 오버라이드의 예외 승인 주체(설계서 §6.5). managerConfirmMode(문서마다의 관리자 서명)와 무관하게 항상 필요하고, 서명이 아니라 review 기록(compliance_flag.resolution + audit_log)이다. GLOBAL 전용 — tenantOverridable에 넣을 수 없다.",
      "properties": {
        "role": {
          "enum": [
            "MANAGER"
          ]
        }
      }
    },
    "masking": {
      "type": "object",
      "required": [
        "name",
        "phone",
        "birthDate"
      ],
      "additionalProperties": false,
      "description": "화면·문서 표시용 부분 마스킹(설계서 §9, 미결정 §14 #12 — 예시값). 앞 keepFirst자·뒤 keepLast자만 남긴다. 로그·예외·toString은 이것과 무관하게 전부 가린다(Sensitive). 테넌트가 사규로 덮어쓸 수 있다.",
      "properties": {
        "name": {
          "type": "object",
          "required": [
            "keepFirst",
            "keepLast",
            "maskChar"
          ],
          "additionalProperties": false,
          "properties": {
            "keepFirst": {
              "type": "integer",
              "minimum": 0
            },
            "keepLast": {
              "type": "integer",
              "minimum": 0
            },
            "maskChar": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          }
        },
        "phone": {
          "type": "object",
          "required": [
            "keepFirst",
            "keepLast",
            "maskChar"
          ],
          "additionalProperties": false,
          "properties": {
            "keepFirst": {
              "type": "integer",
              "minimum": 0
            },
            "keepLast": {
              "type": "integer",
              "minimum": 0
            },
            "maskChar": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          }
        },
        "birthDate": {
          "type": "object",
          "required": [
            "keepFirst",
            "keepLast",
            "maskChar"
          ],
          "additionalProperties": false,
          "properties": {
            "keepFirst": {
              "type": "integer",
              "minimum": 0
            },
            "keepLast": {
              "type": "integer",
              "minimum": 0
            },
            "maskChar": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            }
          }
        }
      }
    },
    "tenantOverridable": {
      "type": "array",
      "uniqueItems": true,
      "description": "TENANT(사규) 룰이 덮어쓸 수 있는 최상위 키 목록. 규제 핵심 키는 넣을 수 없다(not/enum) — \"사규는 규제를 완화할 수 없다\"의 데이터 표현(Phase 1 지시문 §3).",
      "items": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$",
        "not": {
          "enum": [
            "tenantOverridable",
            "validations",
            "minCompare",
            "signerSet",
            "managerConfirmMode",
            "subjectRule",
            "gradeRequired",
            "allowedGradingPolicies",
            "allowedRankingPolicies",
            "allowedTieBreaks",
            "exceptionApproval",
            "voidReasons",
            "supersedeReasons",
            "lifecycleReasonTextMaxLength",
            "retentionAnchors"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "managerConfirmMode": {
            "const": "REQUIRED"
          }
        },
        "required": [
          "managerConfirmMode"
        ]
      },
      "then": {
        "properties": {
          "signerSet": {
            "contains": {
              "const": "MANAGER"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "managerConfirmMode": {
            "enum": [
              "OPTIONAL",
              "OFF"
            ]
          }
        },
        "required": [
          "managerConfirmMode"
        ]
      },
      "then": {
        "properties": {
          "signerSet": {
            "not": {
              "contains": {
                "const": "MANAGER"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "policyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
      }
    }
  }
}
