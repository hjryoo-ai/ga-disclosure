{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/contracts/rules/v1/rule-version.schema.json",
  "title": "rule_version.body (v1)",
  "description": "룰 버전 본문(설계서 부록 D). 룰은 코드가 아니라 데이터다 — 값은 전부 예시이며 실값은 설계서 §14 확인 후 데이터로 설정한다. GLOBAL(규제) 본문은 이 스키마를 그대로 통과해야 하고, TENANT(사규) 본문은 tenantOverridable 키만 가진 부분 문서로서 GLOBAL 위에 병합한 결과가 이 스키마를 통과해야 한다(설계서 §6.2). 필드 추가는 호환(additionalProperties 허용), 삭제·의미 변경은 v2.",
  "type": "object",
  "required": [
    "minCompare",
    "distinctInsurer",
    "gradeRequired",
    "allowedGradingPolicies",
    "allowedRankingPolicies",
    "snapshotMaxAgeDays",
    "reasonCodes",
    "signerSet",
    "signOrder",
    "managerConfirmMode",
    "signDeadlineDays",
    "gateRequiresManager",
    "remoteLinkTtlHours",
    "channels",
    "identityCheck",
    "proxySignatureDetection",
    "anchor",
    "subjectRule",
    "kpi",
    "retentionYears",
    "retainUnlinked",
    "validations",
    "allowedTieBreaks",
    "reasonTextMaxLength",
    "tenantOverridable"
  ],
  "properties": {
    "minCompare": {
      "type": "integer",
      "minimum": 1,
      "description": "최소 비교(추천) 상품 수"
    },
    "distinctInsurer": {
      "type": "boolean"
    },
    "gradeRequired": {
      "type": "object",
      "required": [
        "whenLargeGa"
      ],
      "properties": {
        "whenLargeGa": {
          "type": "boolean"
        }
      }
    },
    "allowedGradingPolicies": {
      "$ref": "#/$defs/policyIds"
    },
    "allowedRankingPolicies": {
      "$ref": "#/$defs/policyIds"
    },
    "allowedTieBreaks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SHARED_RANK",
          "STRICT"
        ]
      },
      "description": "엔진 응답 tieBreak의 허용값(설계서 §4.1·§6.3 (iv))"
    },
    "snapshotMaxAgeDays": {
      "type": "integer",
      "minimum": 0
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiresText": {
            "type": "boolean"
          },
          "auto": {
            "type": "boolean",
            "description": "시스템이 조건에 따라 부가하는 코드(예: 고객 요청 보험사). 설계사 선택지가 아니다."
          }
        }
      }
    },
    "reasonTextMaxLength": {
      "type": "integer",
      "minimum": 1,
      "description": "R-REASON 추천사유 텍스트 길이 상한(문자 수)"
    },
    "signerSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CUSTOMER",
          "AGENT",
          "MANAGER"
        ]
      }
    },
    "signOrder": {
      "enum": [
        "SEQUENTIAL",
        "PARALLEL"
      ],
      "description": "SEQUENTIAL(signerSet 순서대로) | PARALLEL(순서 무관, 전원 필요)"
    },
    "managerConfirmMode": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "OFF"
      ],
      "description": "REQUIRED면 signerSet에 MANAGER가 있어야 하고, OPTIONAL·OFF면 없어야 한다(아래 allOf)"
    },
    "signDeadlineDays": {
      "type": "integer",
      "minimum": 0
    },
    "gateRequiresManager": {
      "type": "boolean"
    },
    "remoteLinkTtlHours": {
      "type": "integer",
      "minimum": 1
    },
    "channels": {
      "type": "object",
      "required": [
        "TOUCH_PAD",
        "REMOTE_LINK",
        "PAPER_SCAN",
        "CERTIFIED_ESIGN"
      ],
      "properties": {
        "TOUCH_PAD": {
          "type": "boolean"
        },
        "REMOTE_LINK": {
          "type": "boolean"
        },
        "PAPER_SCAN": {
          "type": "boolean"
        },
        "CERTIFIED_ESIGN": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "identityCheck": {
      "type": "object",
      "required": [
        "maxFailures"
      ],
      "properties": {
        "maxFailures": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^(TOUCH_PAD|REMOTE_LINK|PAPER_SCAN|CERTIFIED_ESIGN)$": {
          "type": "array",
          "items": {
            "enum": [
              "LINK_POSSESSION",
              "BIRTH_DATE",
              "AGENT_FACE_TO_FACE",
              "SCROLL_COMPLETE",
              "PROVIDER"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "proxySignatureDetection": {
      "type": "object",
      "required": [
        "sameDeviceDistinctCustomersPerDay",
        "minSecondsFromSendToSign"
      ],
      "properties": {
        "sameDeviceDistinctCustomersPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "minSecondsFromSendToSign": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "anchor": {
      "type": "object",
      "required": [
        "externalTimestamp"
      ],
      "properties": {
        "externalTimestamp": {
          "type": "boolean"
        },
        "tsaProfile": {
          "type": "string"
        }
      }
    },
    "subjectRule": {
      "type": "object",
      "required": [
        "largeGaOnly",
        "excludedGroups",
        "contractDateFrom"
      ],
      "properties": {
        "largeGaOnly": {
          "type": "boolean"
        },
        "excludedGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractDateFrom": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "kpi": {
      "type": "object",
      "required": [
        "collectionRate"
      ],
      "properties": {
        "collectionRate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retentionYears": {
      "type": "integer",
      "minimum": 1
    },
    "retainUnlinked": {
      "type": "boolean"
    },
    "validations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^R-[A-Z0-9-]+$"
      }
    },
    "tenantOverridable": {
      "type": "array",
      "uniqueItems": true,
      "description": "TENANT(사규) 룰이 덮어쓸 수 있는 최상위 키 목록. 규제 핵심 키는 넣을 수 없다(not/enum) — \"사규는 규제를 완화할 수 없다\"의 데이터 표현(Phase 1 지시문 §3).",
      "items": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$",
        "not": {
          "enum": [
            "tenantOverridable",
            "validations",
            "minCompare",
            "signerSet",
            "managerConfirmMode",
            "subjectRule",
            "gradeRequired",
            "allowedGradingPolicies",
            "allowedRankingPolicies",
            "allowedTieBreaks"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "managerConfirmMode": {
            "const": "REQUIRED"
          }
        },
        "required": [
          "managerConfirmMode"
        ]
      },
      "then": {
        "properties": {
          "signerSet": {
            "contains": {
              "const": "MANAGER"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "managerConfirmMode": {
            "enum": [
              "OPTIONAL",
              "OFF"
            ]
          }
        },
        "required": [
          "managerConfirmMode"
        ]
      },
      "then": {
        "properties": {
          "signerSet": {
            "not": {
              "contains": {
                "const": "MANAGER"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "policyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
      }
    }
  }
}
