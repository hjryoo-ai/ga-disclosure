{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/contracts/events/v1/envelope.schema.json",
  "title": "이벤트 Envelope (v1)",
  "description": "아웃박스 이벤트 공통 봉투(설계서 §4.5). 포털 설계서 v1.1 §4.1 Envelope 규약과 필드·의미가 같다(Phase 1에서 대조·정렬, 차이는 docs/phase-01-보고서.md). 호환성: 소비자는 모르는 필드를 무시한다. 지원하는 최대 version보다 큰 이벤트를 만나면 그 테넌트의 소비를 정지하고 운영 알림. seq 규칙(소비자): 기대값(last+1)보다 작으면 무시, 같으면 적용, 크면(갭) 정지.",
  "type": "object",
  "required": ["eventId", "seq", "type", "version", "occurredAt", "aggregate", "payload"],
  "properties": {
    "eventId": { "$ref": "defs.schema.json#/$defs/uuid", "description": "멱등키(UNIQUE)" },
    "seq": { "type": "integer", "minimum": 1, "description": "발행자(테넌트) 내 단조 증가 정수. 피드는 seq 오름차순·갭 없음" },
    "type": {
      "description": "이벤트 타입명",
      "enum": ["DisclosureCreated", "DisclosureSealed", "SignatureCaptured", "DisclosureCompleted", "DisclosureVoided", "DisclosureSuperseded", "PolicyLinked", "ComplianceFlagRaised"]
    },
    "version": { "type": "integer", "minimum": 1, "description": "payload 스키마 버전(정수). 필드 추가는 호환, 삭제·의미 변경·타입 변경은 version 증가" },
    "occurredAt": { "$ref": "defs.schema.json#/$defs/instant", "description": "ISO-8601, 오프셋 포함" },
    "aggregate": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["DISCLOSURE", "COMPLIANCE_FLAG"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "DisclosureCreated" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/DisclosureCreated.schema.json" } } } },
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "DisclosureSealed" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/DisclosureSealed.schema.json" } } } },
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "SignatureCaptured" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/SignatureCaptured.schema.json" } } } },
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "DisclosureCompleted" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/DisclosureCompleted.schema.json" } } } },
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "DisclosureVoided" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/DisclosureVoided.schema.json" } } } },
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "DisclosureSuperseded" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/DisclosureSuperseded.schema.json" } } } },
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "PolicyLinked" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/PolicyLinked.schema.json" } } } },
    { "if": { "required": ["type", "version"], "properties": { "type": { "const": "ComplianceFlagRaised" }, "version": { "const": 1 } } }, "then": { "properties": { "payload": { "$ref": "payloads/ComplianceFlagRaised.schema.json" } } } }
  ]
}
